# Copy to backend/.env for local development; never commit the real .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=replace-with-a-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
PAYMENT_MODE=mock
ALLOW_MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=spotsync-backend
